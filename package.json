{
  "name": "@mostafa-hussein-dev/ui",
  "version": "0.1.0",
  "description": "Systemize design system — shared Tailwind v4 tokens, React (shadcn-style) UI primitives, and an app shell for a consistent look across all projects.",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mostafa-Hussein-Dev/systemize-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
